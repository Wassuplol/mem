# --- Discord (Developer Portal -> your app) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: register bot commands instantly in one dev guild (else global, ~1h)
DEV_GUILD_ID=

# Optional privileged intents (enable the toggles in the Dev Portal first!)
ENABLE_MEMBERS_INTENT=0   # welcome/goodbye + member join/leave logs
ENABLE_MESSAGE_CONTENT=0  # message content in delete/edit logs

# --- Services (match docker-compose defaults) ---
DATABASE_URL=postgresql://mem:mem@localhost:5432/mem
REDIS_URL=redis://localhost:6379

# --- Dashboard auth (Better Auth) ---
BETTER_AUTH_URL=http://localhost:3000
# Generate one with: npx auth@latest secret
BETTER_AUTH_SECRET=

# --- AI (any OpenAI-compatible endpoint; optional in P1) ---
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Memi, the 3D AI assistant (optional) ---
# Free key: https://build.nvidia.com (OpenAI-compatible endpoint)
# NVIDIA_API_KEY=nvapi-...
# NIM_MODEL=meta/llama-3.2-11b-vision-instruct
